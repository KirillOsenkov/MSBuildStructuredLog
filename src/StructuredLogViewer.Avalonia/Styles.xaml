<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:structuredLogger="clr-namespace:Microsoft.Build.Logging.StructuredLogger;assembly=StructuredLogger"
        xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
        x:DataType="structuredLogger:BaseNode">

    <Design.DataContext>
        <structuredLogger:BaseNode />
    </Design.DataContext>

    <Style Selector="Window.mainWindow">
        <Setter Property="Background" Value="{DynamicResource Theme_Background}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- classic always-visible scrollbars like WPF -->
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource Theme_ScrollBarBackground}"/>
    </Style>

    <!-- ScrollViewer.AllowAutoHide (distinct from ScrollBar.AllowAutoHide above) controls
         whether the Fluent template overlays the scrollbars on top of the viewport; without
         this the content's bottom row hides behind the horizontal scrollbar. TreeView needs
         the attached property because its template forwards it to the inner ScrollViewer
         with a TemplateBinding, which outranks a style on the ScrollViewer itself. -->
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>
    <Style Selector="TreeView">
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False"/>
    </Style>

    <!-- compact WPF-style checkbox (Fluent hardcodes a 20px box in its template) -->
    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Background="Transparent">
                    <Border Name="checkBorder"
                            Width="14"
                            Height="14"
                            BorderThickness="1"
                            BorderBrush="#FF707070"
                            Background="{DynamicResource Theme_WhiteBackground}"
                            VerticalAlignment="Center">
                        <Path Name="checkMark"
                              Width="9"
                              Height="9"
                              Stretch="Uniform"
                              Data="M 0,4 L 3,8 L 9,0"
                              Stroke="{DynamicResource Theme_InfoBarForeground}"
                              StrokeThickness="2"
                              IsVisible="False" />
                    </Border>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="5,0,0,0"
                                      VerticalAlignment="Center" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#checkMark">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#checkBorder">
        <Setter Property="BorderBrush" Value="#FF3399FF" />
    </Style>

    <!-- macOS: Avalonia's default resolves to Helvetica, whose small ascent (9.24px
         @12px vs Segoe UI's 12.95) parks text visibly above WPF's baseline and reads
         denser; Tahoma ships with macOS and nearly matches Segoe UI metrics -->
    <Style Selector="Window">
        <Setter Property="FontFamily">
            <OnPlatform x:TypeArguments="FontFamily" Default="{x:Static FontFamily.Default}">
                <On Options="macOS" Content=".AppleSystemUIFont"/>
            </OnPlatform>
        </Setter>
    </Style>

    <!-- square corners and compact padding on text boxes, matching WPF chrome;
         center text vertically — WPF boxes auto-size around the text, Avalonia's
         stretch and pin it to the top -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Theme_TextSelection}"/>
    </Style>

    <!-- Fluent swaps in a thick accent border on hover/focus; keep the control's own border -->
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{Binding $parent[TextBox].BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{Binding $parent[TextBox].BorderThickness}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{Binding $parent[TextBox].BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{Binding $parent[TextBox].BorderThickness}"/>
    </Style>

    <!-- WPF's main tree is opaque window-white, not the window chrome color -->
    <Style Selector="TreeView.searchable">
        <Setter Property="Background" Value="{DynamicResource Theme_WhiteBackground}"/>
    </Style>

    <!-- small left inset before the expander column, like WPF -->
    <Style Selector="TreeView">
        <Setter Property="Padding" Value="4,0,0,0"/>
    </Style>

    <!-- Avalonia's Segoe UI line metrics are taller than WPF's; pin tree text to
         WPF's line height so rows come out identical. Center vertically: node rows
         are horizontal StackPanels where the 16px icon plus margins sets a ~20px
         row height, and a stretched TextBlock draws its line at the top -->
    <!-- :is() so NodeHyperlinkControl (derives from TextBlock) is covered too -->
    <Style Selector="TreeViewItem :is(TextBlock)">
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ListBox#breadCrumb TextBlock">
        <Setter Property="LineHeight" Value="16"/>
    </Style>

    <!-- classic TabControl: bordered content area, tab strip outside the frame.
         Default template is for TabStripPlacement=Bottom (all BuildControl tab strips);
         the document well uses Classes="topTabs" for the top-strip variant. -->
    <Style Selector="TabControl">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="*,Auto">
                    <Border Grid.Row="0"
                            Background="{DynamicResource Theme_WhiteBackground}"
                            BorderBrush="{DynamicResource Theme_ControlBorder}"
                            BorderThickness="1">
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </Border>
                    <ItemsPresenter Grid.Row="1"
                                    Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.topTabs">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*">
                    <ItemsPresenter Grid.Row="0"
                                    Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                    <Border Grid.Row="1"
                            Background="{DynamicResource Theme_WhiteBackground}"
                            BorderBrush="{DynamicResource Theme_ControlBorder}"
                            BorderThickness="1">
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- always reserve the expander column (WPF reserves 19px) so icons on leaf
         items line up with icons on expandable items -->
    <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
        <Setter Property="MinWidth" Value="19"/>
    </Style>

    <!-- WPF-style expander triangle: hollow right-pointing triangle when collapsed,
         dark filled triangle when expanded, light blue on hover -->
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Width="16"
                        Height="16"
                        Background="Transparent">
                    <Path Name="ExpandPath"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          StrokeThickness="1" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron /template/ Path#ExpandPath">
        <Setter Property="Data" Value="M 0,0 L 4,4 L 0,8 Z"/>
        <Setter Property="Fill" Value="White"/>
        <Setter Property="Stroke" Value="#FF818181"/>
    </Style>
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:pointerover /template/ Path#ExpandPath">
        <Setter Property="Stroke" Value="#FF27C7F7"/>
        <Setter Property="Fill" Value="#FFCCEEFB"/>
    </Style>
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:checked /template/ Path#ExpandPath">
        <Setter Property="Data" Value="M 6,0 L 6,6 L 0,6 Z"/>
        <Setter Property="Fill" Value="#FF595959"/>
        <Setter Property="Stroke" Value="#FF262626"/>
    </Style>
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:checked:pointerover /template/ Path#ExpandPath">
        <Setter Property="Stroke" Value="#FF1CC4F7"/>
        <Setter Property="Fill" Value="#FF82DFFB"/>
    </Style>

    <Style Selector="Button.close">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="border"
                        Background="Transparent"
                        IsVisible="{TemplateBinding IsVisible}">
                    <Path Width="10"
                          Height="8"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Fill="{TemplateBinding TextBlock.Foreground}"
                          Stretch="Uniform"
                          Data="F1 M 0,0L 2,0L 5,3L 8,0L 10,0L 6,4L 10,8L 8,8L 5,5L 2,8L 0,8L 4,4L 0,0 Z" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.close:pointerover /template/ Border#border">
        <Setter Property="Background" Value="LightBlue" />
    </Style>
    
    <!-- Fluent control themes set FontSize=14 explicitly; match WPF's 12 -->
    <!-- classic WPF-style tabs: bordered boxes, selected tab lighter -->
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="Margin" Value="0,0,-1,0" />
        <Setter Property="Background" Value="{DynamicResource Theme_TabBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme_InfoBarForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme_ControlBorder}" />
        <!-- bottom-placed tabs: the edge facing the content pane stays open, like WPF -->
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- center header text (TabItem only hosts the header; tab content lives in
         the TabControl's presenter, so scoping to all TextBlocks here is safe) -->
    <Style Selector="TabItem TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Background" Value="{DynamicResource Theme_TabSelectedBackground}" />
        <!-- Fluent turns the selected header accent-colored; WPF keeps it plain -->
        <Setter Property="Foreground" Value="{DynamicResource Theme_InfoBarForeground}" />
        <!-- overlap the content border so the selected tab merges with the pane -->
        <Setter Property="Margin" Value="0,-1,-1,0" />
        <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Theme_TabHoverBackground}" />
    </Style>
    <Style Selector="TabItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource Theme_TabSelectedBackground}" />
    </Style>

    <Style Selector="TabControl.topTabs TabItem">
        <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>
    <Style Selector="TabControl.topTabs TabItem:selected">
        <Setter Property="Margin" Value="0,0,-1,-1" />
    </Style>

    <!-- Fluent styles the header presenter directly (gray unselected, accent selected);
         WPF tab text is plain black in all states -->
    <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Theme_InfoBarForeground}" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Theme_InfoBarForeground}" />
    </Style>
    <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Theme_InfoBarForeground}" />
    </Style>
    <Style Selector="TabItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Theme_InfoBarForeground}" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Menu">
        <Setter Property="Padding" Value="0" />
        <!-- Fluent pins the menu bar to a fixed height; size to content like WPF -->
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Menu > MenuItem">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinHeight" Value="0" />
        <!-- Fluent pins top-level menu items to a fixed height; let them hug the text -->
        <Setter Property="Height" Value="NaN" />
    </Style>

    <!-- compact list items everywhere (Fluent uses 40px touch targets) -->
    <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <!-- compact expander header (welcome screen recent lists) -->
    <Style Selector="Expander /template/ ToggleButton">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- classic WPF button chrome -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource Theme_ButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme_ButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Theme_ButtonHoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme_ButtonHoverBorder}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Theme_ButtonPressedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme_ButtonPressedBorder}" />
    </Style>

    <!-- compact breadcrumb items with no hover/selection chrome, like WPF -->
    <Style Selector="ListBox#breadCrumb">
        <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style Selector="ListBox#breadCrumb ListBoxItem">
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  VerticalContentAlignment="Center" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <!-- no keyboard-focus rectangle around the focused row; selection color is enough (like WPF) -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    
    <Style Selector="TreeView.searchable TreeViewItem">
        <Style.Resources>
            <converters:MarginMultiplierConverter Indent="19" Left="True" x:Key="LeftMarginConverter" />
            <SolidColorBrush x:Key="SearchResultStroke"
                             Color="OrangeRed" />
            <SolidColorBrush x:Key="ContainsSearchResultStroke"
                             Color="LightCoral" />
            <SolidColorBrush x:Key="SearchResultBrush"
                             Color="DarkOrange" />
            <SolidColorBrush x:Key="ContainsSearchResultBrush"
                             Color="Bisque" />
        </Style.Resources>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <Border Name="PART_LayoutRoot"
                            Focusable="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            MinHeight="{TemplateBinding MinHeight}"
                            TemplatedControl.IsTemplateFocusTarget="True">
                        <Grid Name="PART_Header"
                              ColumnDefinitions="Auto, *"
                              HorizontalAlignment="Left"
                              Margin="{TemplateBinding Level, Mode=OneWay, Converter={StaticResource LeftMarginConverter}}" >
                            <Panel Name="PART_ExpandCollapseChevronContainer">
                                <ToggleButton Name="PART_ExpandCollapseChevron"
                                              Theme="{StaticResource FluentTreeViewExpandCollapseChevron}"
                                              Focusable="False"
                                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"/>
                            </Panel>
                            <ContentPresenter Name="PART_HeaderPresenter"
                                              Focusable="False"
                                              Content="{TemplateBinding Header}"
                                              HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                              Padding="{TemplateBinding Padding}"
                                              Grid.Column="1"/>
                            <Ellipse Grid.Column="1"
                                     Width="6" Height="6" Margin="1,1,0,0" StrokeThickness="1"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="{StaticResource ContainsSearchResultBrush}"
                                     Stroke="{StaticResource ContainsSearchResultStroke}"
                                     IsVisible="{Binding ContainsSearchResult}"/>
                            <Ellipse Grid.Column="1"
                                     Width="6" Height="6" Margin="1,1,0,0" StrokeThickness="1"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="{StaticResource SearchResultBrush}"
                                     Stroke="{StaticResource SearchResultStroke}"
                                     IsVisible="{Binding IsSearchResult}"/>
                        </Grid>
                    </Border>
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    IsVisible="{TemplateBinding IsExpanded}"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    
</Styles>
