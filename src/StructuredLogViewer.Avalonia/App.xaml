<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Microsoft.Build.Logging.StructuredLogger;assembly=StructuredLogger"
             xmlns:common="clr-namespace:Microsoft.Build.Logging.StructuredLogger;assembly=StructuredLogViewer.Core"
             xmlns:s="clr-namespace:StructuredLogViewer.Avalonia.Controls;assembly=StructuredLogViewer.Avalonia"
             xmlns:avalonia="clr-namespace:StructuredLogViewer.Avalonia;assembly=StructuredLogViewer.Avalonia"
             x:Class="StructuredLogViewer.Avalonia.App"
             RequestedThemeVariant="Light"
             Name="MSBuild Structured Log Viewer">

    <Application.Resources>
        <ResourceDictionary>
            <s:ProxyNodeIconConverter x:Key="ProxyNodeIconConverter" />
            <s:ProjectIconConverter x:Key="ProjectIconConverter" />
            <s:NodeLowRelevanceToOpacityConverter x:Key="RelevanceConverter" />
            <s:NodeIsSelectedToColorConverter x:Key="LabelColorConverter" />
            <s:FolderForegroundConverter x:Key="FolderForegroundConverter" />
            <s:FolderIconFillConverter x:Key="FolderIconFillConverter" />
            <s:HighlightedTextBackgroundConverter x:Key="HighlightBackgroundConverter" />
            <s:FileCopyKindToIconConverter x:Key="FileCopyIconConverter" />
            <s:NoImportReasonBackgroundConverter x:Key="NoImportReasonBackgroundConverter" />

            <!-- Fluent defaults to 14; WPF uses 12 - controls read this resource directly -->
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>

            <!-- target framework chip, same values as WPF Generic.xaml -->
            <SolidColorBrush x:Key="TargetFrameworkBackground">#E5F0E5</SolidColorBrush>
            <SolidColorBrush x:Key="TargetFrameworkForeground">#274E13</SolidColorBrush>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Theme_Background">#EEEEF2</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_WhiteBackground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ToolWindowBackground">WhiteSmoke</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_InfoBarBackground">#FFFFE1</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_InfoBarForeground">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_GrayText">Gray</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ControlBackground">#F0F0F0</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ControlBorder">#ACACAC</SolidColorBrush>

                    <!-- classic WPF button colors (see WPF ThemeManager.UpdateTheme) -->
                    <SolidColorBrush x:Key="Theme_ButtonBackground">#F0F0F0</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ButtonBorder">#707070</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ButtonHoverBackground">#BEE6FD</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ButtonHoverBorder">#3C7FB1</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ButtonPressedBackground">#C4E5F6</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ButtonPressedBorder">#2C628B</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_TabBackground">#F0F0F0</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_TabHoverBackground">#D8EAF9</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_TabSelectedBackground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ScrollBarBackground">#F0F0F0</SolidColorBrush>

                    <!-- plain white text boxes like WPF (Fluent tints them gray at rest) -->
                    <SolidColorBrush x:Key="TextControlBackground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">White</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused">White</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_TextSelection">#99C9EF</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_EditorSelection">#4CA0E3</SolidColorBrush>

                    <!-- node adornments (same values as WPF ThemeManager light theme) -->
                    <SolidColorBrush x:Key="NuGet">#004880</SolidColorBrush>
                    <SolidColorBrush x:Key="NoImportFill">BlanchedAlmond</SolidColorBrush>

                    <!-- match WPF: no hover background, LightSkyBlue selection with dark text -->
                    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver">Transparent</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemBackgroundPressed">Transparent</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected">LightSkyBlue</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver">LightSkyBlue</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed">LightSkyBlue</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemForegroundPointerOver">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemForegroundPressed">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemForegroundSelected">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed">Black</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Theme_Background">#454545</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_WhiteBackground">#303030</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ToolWindowBackground">#303030</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_InfoBarBackground">#202040</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_InfoBarForeground">#E0E0E0</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_GrayText">LightGray</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ControlBackground">#454545</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ControlBorder">#555555</SolidColorBrush>

                    <SolidColorBrush x:Key="Theme_ButtonBackground">#3F3F46</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ButtonBorder">#666666</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ButtonHoverBackground">#3B5464</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ButtonHoverBorder">#36A2DB</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ButtonPressedBackground">#2D4A5E</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ButtonPressedBorder">#36A2DB</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_TabBackground">#3F3F46</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_TabHoverBackground">#3B5464</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_TabSelectedBackground">#303030</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_ScrollBarBackground">#3E3E42</SolidColorBrush>

                    <!-- text boxes match the dark editor background -->
                    <SolidColorBrush x:Key="TextControlBackground">#303030</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#303030</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused">#303030</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_TextSelection">#264F78</SolidColorBrush>
                    <SolidColorBrush x:Key="Theme_EditorSelection">#264F78</SolidColorBrush>

                    <!-- node adornments (same values as WPF ThemeManager dark theme) -->
                    <SolidColorBrush x:Key="NuGet">DeepSkyBlue</SolidColorBrush>
                    <SolidColorBrush x:Key="NoImportFill">#474138</SolidColorBrush>

                    <!-- match WPF dark theme: SlateBlue selection, no hover background -->
                    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver">Transparent</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemBackgroundPressed">Transparent</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected">SlateBlue</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver">SlateBlue</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed">SlateBlue</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemForegroundPointerOver">#E0E0E0</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemForegroundPressed">#E0E0E0</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemForegroundSelected">White</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver">White</SolidColorBrush>
                    <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed">White</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="/Styles.xaml" />
        
        <!-- keep in sync with the WPF NodeIcon style (Generic.xaml) so row heights match -->
        <Style Selector="Rectangle.nodeIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Margin" Value="3,3,6,3" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="Image.projectNodeIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="2,2,5,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.nodeBeforeText">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="TextBlock.nodeText">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Application.Styles>

    <NativeDock.Menu>
        <NativeMenu>
            <NativeMenuItem Header="New Instance" Command="{x:Static avalonia:MacOsAppBundleRunner.NewInstanceCommand}"/>
        </NativeMenu>
    </NativeDock.Menu>

    <Application.DataTemplates>

        <TreeDataTemplate DataType="{x:Type l:Folder}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Name="folderRoot"
                        Opacity="{Binding IsLowRelevance, Converter={StaticResource RelevanceConverter}}">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource FolderStroke}"
                           Fill="{Binding Name, Converter={StaticResource FolderIconFillConverter}}" />
                <TextBlock Name="nameText"
                           Classes="nodeText"
                           Text="{Binding Name}">
                    <TextBlock.Foreground>
                        <MultiBinding Converter="{StaticResource FolderForegroundConverter}">
                            <Binding Path="IsSelected" />
                            <Binding Path="Name" />
                        </MultiBinding>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:Project}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Name="projectRoot"
                        Opacity="{Binding IsLowRelevance, Converter={StaticResource RelevanceConverter}}">
                <Image Classes="projectNodeIcon">
                    <Image.Source>
                        <DrawingImage Drawing="{Binding ProjectFileExtension, Converter={StaticResource ProjectIconConverter}}" />
                    </Image.Source>
                </Image>
                <TextBlock Classes="nodeText"
                           Text="{Binding Name}"
                           ToolTip.Tip="{Binding ToolTip}" />
                <TextBlock Text="{Binding AdornmentString}"
                           Margin="6,0,0,0"
                           Padding="2,0,2,0"
                           FontSize="10"
                           LineHeight="14"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TargetFrameworkForeground}"
                           Background="{DynamicResource TargetFrameworkBackground}"
                           IsVisible="{Binding AdornmentString, Converter={StaticResource StringEmptinessToVisibilityConverter}, ConverterParameter=Invert}" />
                <s:NodeHyperlinkControl Classes="nodeText"
                                        Margin="6,0,0,0"
                                        Text="{Binding TargetsDisplayText}"
                                        Foreground="{StaticResource TargetStroke}"
                                        ToolTip.Tip="Initial targets"
                                        IsVisible="{Binding TargetsDisplayText, Converter={StaticResource StringEmptinessToVisibilityConverter}, ConverterParameter=Invert}" />
                <s:NodeHyperlinkControl Classes="nodeText"
                                        Margin="6,0,0,0"
                                        Text="{Binding EvaluationText}"
                                        HyperlinkKind="Evaluation"
                                        Opacity="0.5"
                                        ToolTip.Tip="Navigate to the evaluation for this project"
                                        IsVisible="{Binding EvaluationText, Converter={StaticResource StringEmptinessToVisibilityConverter}, ConverterParameter=Invert}" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:ProjectEvaluation}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Name="projectRoot"
                        Opacity="{Binding IsLowRelevance, Converter={StaticResource RelevanceConverter}}">
                <Image Classes="projectNodeIcon">
                    <Image.Source>
                        <DrawingImage Drawing="{Binding ProjectFileExtension, Converter={StaticResource ProjectIconConverter}}" />
                    </Image.Source>
                </Image>
                <TextBlock Classes="nodeText"
                           Text="{Binding Name}"
                           ToolTip.Tip="{Binding ToolTip}" />
                <TextBlock Text="{Binding AdornmentString}"
                           Margin="6,0,0,0"
                           Padding="2,0,2,0"
                           FontSize="10"
                           LineHeight="14"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TargetFrameworkForeground}"
                           Background="{DynamicResource TargetFrameworkBackground}"
                           IsVisible="{Binding AdornmentString, Converter={StaticResource StringEmptinessToVisibilityConverter}, ConverterParameter=Invert}" />
                <TextBlock Text="{Binding EvaluationText}"
                           Margin="6,0,0,0"
                           Opacity="0.5"
                           ToolTip.Tip="Evaluation Id"
                           IsVisible="{Binding EvaluationText, Converter={StaticResource StringEmptinessToVisibilityConverter}, ConverterParameter=Invert}" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:Target}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Name="targetRoot"
                        Opacity="{Binding IsLowRelevance, Converter={StaticResource RelevanceConverter}}">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource TargetStroke}"
                           Fill="{StaticResource TargetBrush}" />
                <TextBlock Name="label"
                           Classes="nodeBeforeText"
                           Text="Target "
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={StaticResource TargetStroke}}" />
                <TextBlock Classes="nodeText"
                           Text="{Binding Name}" />
                <TextBlock Name="duration"
                           Classes="nodeText"
                           Text="{Binding DurationText}"
                           ToolTip.Tip="{Binding ToolTip}"
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={x:Static Brushes.LightGray}}" />
                <s:NodeHyperlinkControl Name="hyperlink"
                                        Classes="nodeText"
                                        Text="{Binding ParentTargetText}"
                                        Foreground="{StaticResource TargetStroke}"
                                        ToolTip.Tip="{Binding ParentTargetTooltip}" />
            </StackPanel>
        </TreeDataTemplate>

        <DataTemplate DataType="{x:Type l:EntryTarget}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource TargetStroke}"
                           Fill="{StaticResource TargetBrush}" />
                <TextBlock Classes="nodeText"
                           Text="{Binding Name}" />
                <TextBlock Name="duration"
                           Classes="nodeText"
                           Text="{Binding DurationText}"
                           ToolTip.Tip="{Binding ToolTip}"
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={x:Static Brushes.LightGray}}" />
                <s:NodeHyperlinkControl Classes="nodeText"
                                        Text=" → Show"
                                        Foreground="LightBlue" />
            </StackPanel>
        </DataTemplate>

        <TreeDataTemplate DataType="{x:Type l:Task}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource TaskStroke}"
                           Fill="{StaticResource TaskBrush}" />
                <TextBlock Name="label"
                           Classes="nodeBeforeText"
                           Text="Task "
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={StaticResource TaskStroke}}"/>
                <TextBlock Classes="nodeText"
                           Text="{Binding Name}" />
                <TextBlock Name="duration"
                           Classes="nodeText"
                           Text="{Binding DurationText}"
                           ToolTip.Tip="{Binding ToolTip}"
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={x:Static Brushes.LightGray}}" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:TaskParameterItem}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Path Name="icon"
                      Data="{StaticResource AddItemGeometry}"
                      VerticalAlignment="Center"
                      Width="14"
                      Height="11"
                      Margin="3,3,6,3"
                      StrokeThickness="1"
                      Stroke="{StaticResource ItemStroke}"
                      Fill="{StaticResource ItemBrush}" />
                <TextBlock Name="label"
                           Classes="nodeBeforeText"
                           Text="Add Item "
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={StaticResource AddItemStroke}}" />
                <TextBlock Text="{Binding Name}"
                           Classes="nodeText" />
                <TextBlock Name="parameterName"
                           Text="{Binding ParameterName}"
                           Foreground="Gray"
                           Margin="16,0,0,0" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:AddItem}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Path Name="icon"
                      Data="{StaticResource AddItemGeometry}"
                      VerticalAlignment="Center"
                      Width="14"
                      Height="11"
                      Margin="3,3,6,3"
                      StrokeThickness="1"
                      Stroke="{StaticResource ItemStroke}"
                      Fill="{StaticResource ItemBrush}" />
                <TextBlock Name="label"
                           Classes="nodeBeforeText"
                           Text="Add Item "
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={StaticResource AddItemStroke}}" />
                <TextBlock Text="{Binding Name}"
                           Classes="nodeText" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:RemoveItem}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Path Name="icon"
                      Data="{StaticResource RemoveItemGeometry}"
                      VerticalAlignment="Center"
                      Width="14"
                      Height="11"
                      Margin="3,3,6,3"
                      StrokeThickness="1"
                      Stroke="{StaticResource ItemStroke}"
                      Fill="{StaticResource ItemBrush}" />
                <TextBlock Name="label"
                           Classes="nodeBeforeText"
                           Text="Remove Item "
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={StaticResource AddItemStroke}}"/>
                <TextBlock Text="{Binding Name}"
                           Classes="nodeText" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:FileCopy}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <ContentPresenter Content="{Binding Kind, Converter={StaticResource FileCopyIconConverter}}" />
                <TextBlock Text="{Binding ShortenedName}"
                           Classes="nodeText" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:Item}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource ItemStroke}"
                           Fill="{StaticResource ItemBrush}" />
                <TextBlock Text="{Binding ShortenedName}"
                           Classes="nodeText" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:Package}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource NuGetGeometry}"
                      Stroke="{DynamicResource NuGet}"
                      VerticalAlignment="Center"
                      StrokeThickness="1"
                      Width="16"
                      Height="16"
                      Margin="1,2,0,2"
                      Fill="{DynamicResource NuGet}" />
                <TextBlock Text="{Binding ShortenedName}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Version}"
                           Margin="6,0,0,0"
                           Foreground="{StaticResource PropertyStroke}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding VersionSpec}"
                           Margin="6,0,0,0"
                           Foreground="{StaticResource ImportStroke}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </TreeDataTemplate>

        <DataTemplate DataType="{x:Type l:Metadata}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource MetadataStroke}"
                           Fill="{StaticResource MetadataBrush}" />
                <TextBlock Name="label"
                           Classes="nodeBeforeText"
                           Text="{Binding NameAndEquals, Mode=OneTime}"
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={x:Static Brushes.LightSeaGreen}}"/>
                <TextBlock Classes="nodeText"
                           Text="{Binding ShortenedValue}" />
            </StackPanel>
        </DataTemplate>
        
        <TreeDataTemplate DataType="{x:Type l:EvaluationProfileEntry}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="40" 
                             Height="9" 
                             Margin="2,1,6,0" 
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Value}"
                             VerticalAlignment="Center" />
                <TextBlock Name="label" 
                           VerticalAlignment="Center"
                           Text="{Binding Title, Mode=OneTime}" />
                <TextBlock Name="hits" 
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           Text="{Binding DurationText, Mode=OneTime}"
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={x:Static Brushes.Blue}}" />
                <TextBlock Name="code"
                           Text="{Binding ShortenedElementDescription}" 
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontFamily="Consolas"
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={x:Static Brushes.Gray}}" />
            </StackPanel>
        </TreeDataTemplate>

        <DataTemplate DataType="{x:Type l:TaskParameterProperty}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource PropertyStroke}"
                           Fill="{StaticResource PropertyBrush}" />
                <TextBlock Name="label"
                           Classes="nodeBeforeText"
                           Text="{Binding NameAndEquals, Mode=OneTime}"
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={StaticResource PropertyStroke}}" />
                <TextBlock Text="{Binding ShortenedValue}"
                           Classes="nodeText" />
                <TextBlock Name="parameterName"
                           Text="{Binding ParameterName}"
                           Foreground="Gray"
                           Margin="16,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type l:Property}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource PropertyStroke}"
                           Fill="{StaticResource PropertyBrush}" />
                <TextBlock Name="label"
                           Classes="nodeBeforeText"
                           Text="{Binding NameAndEquals, Mode=OneTime}"
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={StaticResource PropertyStroke}}" />
                <TextBlock Text="{Binding ShortenedValue}"
                           Classes="nodeText" />
            </StackPanel>
        </DataTemplate>

        <TreeDataTemplate DataType="{x:Type l:Parameter}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource ParameterStroke}"
                           Fill="{StaticResource ParameterBrush}" />
                <TextBlock Name="name"
                           Classes="nodeText"
                           Text="{Binding Name}"
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={StaticResource ParameterStroke}}" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:TimedMessage}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource MessageStroke}"
                           Fill="{StaticResource MessageBrush}" />
                <TextBlock Name="timeStamp"
                           Text="{Binding TimestampText}"
                           Opacity="0.3"
                           Margin="0,0,8,0" />
                <TextBlock Name="messageText"
                           Classes="nodeText"
                           Text="{Binding ShortenedText}"
                           Opacity="{Binding IsLowRelevance, Converter={StaticResource RelevanceConverter}}" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:Message}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource MessageStroke}"
                           Fill="{StaticResource MessageBrush}" />
                <TextBlock Name="messageText"
                           Classes="nodeText"
                           Text="{Binding ShortenedText}"
                           Opacity="{Binding IsLowRelevance, Converter={StaticResource RelevanceConverter}}" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:MSBuildServerNode}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource MSBuildServerStroke}"
                           Fill="{StaticResource MSBuildServerBrush}" />
                <TextBlock Name="messageText"
                           Classes="nodeText"
                           Text="{Binding ShortenedText}"
                           Opacity="{Binding IsLowRelevance, Converter={StaticResource RelevanceConverter}}" />
            </StackPanel>
        </TreeDataTemplate>
        
        <TreeDataTemplate DataType="{x:Type l:Import}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Opacity="{Binding IsLowRelevance, Converter={StaticResource RelevanceConverter}}">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource ImportStroke}"
                           Fill="{StaticResource ImportBrush}" />
                <TextBlock x:Name="label"
                           Classes="nodeBeforeText"
                           Text="Import "
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={StaticResource ImportStroke}}" />
                <TextBlock x:Name="name"
                           Classes="nodeText"
                           Text="{Binding Text}" />
                <TextBlock x:Name="location"
                           Classes="nodeText"
                           Text="{Binding Location}" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:NoImport}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Opacity="{Binding IsLowRelevance, Converter={StaticResource RelevanceConverter}}">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource NoImportStroke}"
                           Fill="{StaticResource NoImportBrush}" />
                <TextBlock x:Name="label"
                           Classes="nodeBeforeText"
                           Text="NoImport "
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={StaticResource NoImportStroke}}" />
                <TextBlock x:Name="text"
                           Classes="nodeText"
                           Text="{Binding Text}" />
                <TextBlock x:Name="location"
                           Classes="nodeText"
                           Text="{Binding Location}" />
                <TextBlock x:Name="reason"
                           Classes="nodeText"
                           Text="{Binding Reason}"
                           Background="{Binding IsSelected, Converter={StaticResource NoImportReasonBackgroundConverter}}" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:TimedNode}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource FolderStroke}"
                           Fill="{StaticResource ClosedFolderBrush}" />
                <TextBlock Name="nameText"
                           Classes="nodeText"
                           Text="{Binding Name}"
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={x:Static Brushes.DarkGoldenrod}}" />
            </StackPanel>
        </TreeDataTemplate>
        
        <DataTemplate DataType="{x:Type common:ButtonNode}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="button"
                        Content="{Binding Text}"
                        Command="{Binding Command}"
                        IsEnabled="{Binding IsEnabled}"
                        Padding="4,2,4,2" />
            </StackPanel>
        </DataTemplate>
        
        <TreeDataTemplate DataType="{x:Type l:Error}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource ErrorStroke}"
                           Fill="{StaticResource ErrorBrush}" />
                <TextBlock Name="text"
                           Classes="nodeText"
                           Text="{Binding}"
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={StaticResource ErrorStroke}}" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:CriticalBuildMessage}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource WarningStroke}"
                           Fill="{StaticResource WarningBrush}" />
                <TextBlock Name="text"
                           Classes="nodeText"
                           Text="{Binding}" />
            </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="{x:Type l:Warning}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource WarningStroke}"
                           Fill="{StaticResource WarningBrush}" />
                <TextBlock Classes="nodeText"
                           Text="{Binding}" />
            </StackPanel>
        </TreeDataTemplate>

        <DataTemplate DataType="{x:Type l:Note}">
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="LightGray"
                        BorderThickness="1"
                        Margin="3"
                        Background="{DynamicResource Theme_InfoBarBackground}"
                        Padding="6">
                    <TextBlock Text="{Binding Text}"
                               Foreground="Gray"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <TreeDataTemplate DataType="{x:Type l:SourceFile}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Name="icon"
                           Classes="nodeIcon"
                           Stroke="{StaticResource MessageStroke}"
                           Fill="{StaticResource MessageBrush}" />
                <TextBlock Name="messageText"
                           Text="{Binding Name}" />
                <TextBlock Text="{Binding SourceFilePath}"
                           Opacity="0.4"
                           Margin="8,0,0,0" />
            </StackPanel>
        </TreeDataTemplate>

        <DataTemplate DataType="{x:Type l:SourceFileLine}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="lineNumber"
                           Text="{Binding LineNumber}"
                           FontFamily="Consolas"
                           Margin="0,0,12,0"
                           Foreground="{Binding IsSelected, Converter={StaticResource LabelColorConverter}, ConverterParameter={x:Static Brushes.Teal}}" />
                <TextBlock Name="messageText"
                           Text="{Binding LineText}"
                           FontFamily="Consolas" />
            </StackPanel>
        </DataTemplate>

        <TreeDataTemplate DataType="{x:Type l:ProxyNode}"
                          ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <ContentPresenter Content="{Binding Converter={StaticResource ProxyNodeIconConverter}}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding Highlights}"
                              Focusable="False">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="{x:Type l:HighlightedText}">
                            <TextBlock Classes="nodeBeforeText"
                                       Foreground="Black"
                                       Background="{Binding Style, Converter={StaticResource HighlightBackgroundConverter}}"
                                       Text="{Binding Text}" />
                        </DataTemplate>
                        <DataTemplate DataType="x:Object">
                            <TextBlock Classes="nodeBeforeText"
                                       Text="{Binding .}" />
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </TreeDataTemplate>

        <DataTemplate DataType="{x:Type common:WelcomeScreen}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
            <DockPanel Name="welcomeScreen">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding Version}"
                           Foreground="Gray"
                           FontSize="16"
                           Margin="20,10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top" />
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Grid Background="{DynamicResource Theme_WhiteBackground}"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Name="customMessage"
                                   Grid.Row="0"
                                   FontSize="16"
                                   Foreground="Red"
                                   Margin="10"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding Message, Converter={StaticResource StringEmptinessToVisibilityConverter}, ConverterParameter=Invert}"
                                   Text="{Binding Message}" />
                        <Grid Name="openLogOrProjectCompartment"
                              Grid.Row="1"
                              ColumnDefinitions="Auto,Auto">
                            <Button Margin="20"
                                    MinWidth="200"
                                    MinHeight="200"
                                    Command="{Binding OpenProjectCommand}">
                                <StackPanel>
                                    <Image Width="100"
                                           Height="100"
                                           Margin="20">
                                        <Image.Source>
                                            <DrawingImage Drawing="{StaticResource SlnIcon}" />
                                        </Image.Source>
                                    </Image>
                                    <TextBlock Text="Open Project/Solution"
                                               FontSize="16"
                                               Margin="10"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,20,20,20"
                                    MinWidth="200"
                                    MinHeight="200"
                                    Command="{Binding OpenLogFileCommand}"
                                    Grid.Column="1">
                                <StackPanel>
                                    <Canvas Width="100"
                                            Height="100"
                                            Margin="20">
                                        <Rectangle Width="35"
                                                   Height="35"
                                                   Canvas.Left="0"
                                                   Canvas.Top="0"
                                                   Stroke="{StaticResource TargetStroke}"
                                                   StrokeThickness="1"
                                                   Fill="{StaticResource TargetBrush}" />
                                        <Rectangle Width="35"
                                                   Height="35"
                                                   Canvas.Left="25"
                                                   Canvas.Top="35"
                                                   Stroke="{StaticResource ParameterStroke}"
                                                   StrokeThickness="1"
                                                   Fill="{StaticResource ParameterBrush}" />
                                        <Rectangle Width="35"
                                                   Height="35"
                                                   Canvas.Left="25"
                                                   Canvas.Top="70"
                                                   Stroke="{StaticResource TaskStroke}"
                                                   StrokeThickness="1"
                                                   Fill="{StaticResource TaskBrush}" />
                                        <Rectangle Width="35"
                                                   Height="35"
                                                   Canvas.Left="60"
                                                   Canvas.Top="35"
                                                   Stroke="{StaticResource ItemStroke}"
                                                   StrokeThickness="1"
                                                   Fill="{StaticResource ItemBrush}" />
                                        <Rectangle Width="35"
                                                   Height="35"
                                                   Canvas.Left="60"
                                                   Canvas.Top="70"
                                                   Stroke="{StaticResource FolderStroke}"
                                                   StrokeThickness="1"
                                                   Fill="{StaticResource ClosedFolderBrush}" />
                                        <Line StartPoint="16,35"
                                              EndPoint="16,87"
                                              Stroke="Black" />
                                        <Line StartPoint="16,87"
                                              EndPoint="25,87"
                                              Stroke="Black" />
                                        <Line StartPoint="16,53"
                                              EndPoint="25,53"
                                              Stroke="Black" />
                                    </Canvas>
                                    <TextBlock Text="Open Log File"
                                               FontSize="16"
                                               Margin="10"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Name="recentProjects"
                              Grid.Row="2"
                              IsVisible="{Binding ShowRecentProjects}">
                            <Expander IsExpanded="True"
                                      Header="Recent projects and solutions"
                                      Margin="10">
                                <ListBox ItemsSource="{Binding RecentProjects}"
                                         Margin="10"
                                         SelectedItem="{Binding SelectedProject, Mode=OneWayToSource}"
                                         Background="Transparent"
                                         BorderBrush="Transparent"
                                         BorderThickness="0" />
                            </Expander>
                        </Grid>
                        <Grid Name="recentLogs"
                              Grid.Row="3"
                              IsVisible="{Binding ShowRecentLogs}">
                            <Expander IsExpanded="True"
                                      Header="Recent logs"
                                      Margin="10">
                                <ListBox ItemsSource="{Binding RecentLogs}"
                                         Margin="10"
                                         SelectedItem="{Binding SelectedLog, Mode=OneWayToSource}"
                                         Background="Transparent"
                                         BorderBrush="Transparent"
                                         BorderThickness="0" />
                            </Expander>
                        </Grid>
                        <StackPanel Grid.Row="4">
                            <!-- WPF has an "Enable tree virtualization" checkbox here;
                                 Avalonia's TreeView has no virtualization to toggle -->
                            <!--<CheckBox Content="Display all targets directly under the project (flattened in temporal order)"
                                      Margin="10,0,10,10"
                                      IsChecked="{Binding ParentAllTargetsUnderProject}"
                                      ToolTip.Tip="Linearize/flatten all targets under the project instead of parenting targets under their dependency target"/>-->
                            <CheckBox Content="Mark search results with a dot in the main tree"
                                      Margin="10,0,10,10"
                                      IsChecked="{Binding MarkResultsInTree}"
                                      ToolTip.Tip="Mark tree nodes that appear in search results with a dot"/>
                            <CheckBox Content="Show project configuration and platform"
                                      Margin="10,0,10,10"
                                      IsChecked="{Binding ShowConfigurationAndPlatform}"
                                      ToolTip.Tip="Show project Configuration and Platform property values if available" />
                            <CheckBox Content="Dark Theme"
                                      Margin="10,0,10,10"
                                      IsChecked="{Binding UseDarkTheme}"
                                      ToolTip.Tip="Use dark theme" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </DockPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type s:BuildParametersScreen}">
            <Grid Name="buildParameters"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="40"
                  RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0"
                            Margin="40,40,40,12">
                    <TextBlock Text="Specify custom MSBuild command line arguments:"
                               Margin="4" />
                    <WrapPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding MSBuildLocations}"
                                  SelectedItem="{Binding MSBuildLocation}"
                                  ToolTip.Tip="Select MSBuild toolset to use for building"
                                  Height="28"
                                  Margin="4,4,0,4"/>
                        <Button Command="{Binding BrowseForMSBuildCommand}"
                                Width="28"
                                Height="28"
                                ToolTip.Tip="Browse for custom MSBuild file location..."
                                Margin="0,4,4,4">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="2"
                                           Height="2"
                                           Margin="2"
                                           Fill="{DynamicResource Theme_InfoBarForeground}" />
                                <Rectangle Width="2"
                                           Height="2"
                                           Margin="0,2,2,2"
                                           Fill="{DynamicResource Theme_InfoBarForeground}" />
                                <Rectangle Width="2"
                                           Height="2"
                                           Margin="0,2,2,2"
                                           Fill="{DynamicResource Theme_InfoBarForeground}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding PrefixArguments}"
                                   Height="28"
                                   Margin="0,4,4,4"
                                   Padding="0,5"
                                   TextWrapping="Wrap" />
                        <TextBox Name="argumentsText"
                                 Text="{Binding MSBuildArguments}"
                                 TextWrapping="Wrap"
                                 Height="28"
                                 MinWidth="300"
                                 Margin="0,4,4,4">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter"
                                            Command="{Binding BuildCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>

                        <TextBlock Text="{Binding PostfixArguments}"
                                   Height="28"
                                   Margin="0,4,4,4"
                                   Padding="0,5"
                                   TextWrapping="Wrap" />
                    </WrapPanel>
                    <Button Content="Copy command line to clipboard"
                            Command="{Binding CopyCommand}"
                            Height="28"
                            HorizontalAlignment="Right"
                            Margin="4" />
                </StackPanel>
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            Margin="40,12,40,40"
                            Orientation="Horizontal">
                    <Button Content="Build"
                            Command="{Binding BuildCommand}"
                            Width="76"
                            Height="28"
                            Margin="4" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Width="76"
                            Height="28"
                            Margin="4" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type common:BuildProgress}">
            <Grid Name="buildProgress"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="40"
                  RowDefinitions="Auto,Auto,Auto">
                <TextBlock Name="text"
                           Text="{Binding ProgressText}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
                <ProgressBar Grid.Row="1"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Value="{Binding Value}"
                             Minimum="0"
                             Maximum="1"
                             HorizontalAlignment="Center"
                             Width="200"
                             Height="23"
                             Margin="10" />
                <TextBlock Name="buffer"
                           Grid.Row="2"
                           Text="{Binding BufferText}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Row="2"
                            Margin="40"
                            IsVisible="{Binding ShowCommandLine}">
                    <TextBlock Text="Using command line (press Ctrl+C to copy):"
                               Margin="0,0,0,7" />
                    <TextBox Text="{Binding MSBuildCommandLine}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Background="{DynamicResource Theme_ControlBackground}"
                             MinHeight="23" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Application.DataTemplates>
</Application>
